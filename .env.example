# URL pública del sitio (usada en metadatos, sitemap y Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.amplextech.com

# Integración de correo para el formulario de contacto (Resend: https://resend.com)
# Si no se configuran, el formulario informará que el envío no está disponible
# y ofrecerá contactar por WhatsApp o correo directo.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="AMPLEX Web <onboarding@resend.dev>"
